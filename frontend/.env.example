# LegalLens frontend environment.
# Copy to .env for local overrides. All values are optional.

# Where the dev server proxies /api. Defaults to the Node.js gateway on :5000.
VITE_GATEWAY_URL=http://localhost:5000

# Base path the browser calls. Defaults to "/api" (same-origin via the dev proxy).
# Set to an absolute gateway URL only if you are NOT using the dev proxy.
# VITE_API_BASE=/api
